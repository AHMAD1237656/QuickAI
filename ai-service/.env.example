# AI Provider configuration
# Set AI_PROVIDER to "demo" to run without any real API key (safe local/dev mode).
# Set it to "gemini" (recommended) or "openai" and provide the matching API key
# below to enable real AI generations.
#
# demo   -> no key needed, returns clearly-labeled placeholder text
# gemini -> Google Gemini, via the official google-genai SDK
# openai -> OpenAI (or any OpenAI-compatible) /chat/completions endpoint
AI_PROVIDER=demo

# --- Gemini configuration (used when AI_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Generic configuration (used when AI_PROVIDER=openai, or as a fallback
#     for the Gemini vars above if you prefer these generic names) ---
AI_API_KEY=
AI_MODEL=

# Only used when AI_PROVIDER=openai and you're pointing at a different
# OpenAI-compatible endpoint than the default OpenAI API.
# AI_BASE_URL=https://api.openai.com/v1

# Port the service listens on (used only for reference in docs/scripts)
PORT=8001
